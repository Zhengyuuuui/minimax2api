__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.DS_Store

# runtime data: the SQLite store, generated media, and anything uvicorn drops
/data/
/data*/
generated/
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

# the bridge's own scratch
.tmp-ref/

# local configuration: secrets live here, the template does not
.env
.env.*
!.env.example

# local-only snapshots of experimental work, kept out of the source tree so an
# accidental `git add -A` cannot publish them.
/archive/

# Captured traffic and recorded runs.  They contain live Authorization /
# Bearer / cookie material and are never part of the source tree.
*.out
/scripts/capture.py
/scripts/walk_recorder.py
