# minimaxcode2api — environment template
#
# Copy to .env and edit, or export these variables from your orchestrator.
# A real environment variable always wins over this file.
#
#   cp .env.example .env
#
# Spelling: MINIMAX2API_<SECTION>__<FIELD>  (double underscore between section
# and field).  Any setting the console exposes can be pinned here; a value set
# here is shown read-only in the console, because the environment wins.
#
# Every line is commented out on purpose: this file documents the surface, it
# does not change a running install.

# ------------------------------------------------------------------ run-level
# Also accepted bare as HOST / PORT / DATA_DIR.
# MINIMAX2API_HOST=127.0.0.1
# MINIMAX2API_PORT=4555
# MINIMAX2API_DATA_DIR=./data
# Where to read the dotenv file from at startup.
# ENV_FILE=.env

# ------------------------------------------------------------------ upstream
# MINIMAX2API_UPSTREAM__BASE_URL=https://agent.minimax.io
# MINIMAX2API_UPSTREAM__BASE_URL_CN=https://agent.minimaxi.com
# Overseas business endpoints are fenced to overseas egress; set a proxy if the
# host is not overseas, or every call answers a bare 401.  May embed credentials:
# socks5://user:pass@host:1080 or http://host:8080
# MINIMAX2API_UPSTREAM__PROXY=
# MINIMAX2API_UPSTREAM__LANGUAGE=zh-CN,zh;q=0.9,en;q=0.8

# ------------------------------------------------------------------ routing
# MINIMAX2API_ROUTING__STRATEGY=least_inflight
# MINIMAX2API_ROUTING__MAX_ATTEMPTS=3
# MINIMAX2API_ROUTING__COOLDOWN_BASE_SEC=60
# MINIMAX2API_ROUTING__COOLDOWN_MAX_SEC=900

# --------------------------------------------------------------------- audit
# MINIMAX2API_AUDIT__RETENTION_DAYS=7
# MINIMAX2API_AUDIT__MAX_RECORDS=5000
# MINIMAX2API_AUDIT__RECORD_BODY=true

# --------------------------------------------------------------------- media
# MINIMAX2API_MEDIA__GENERATED_DIR=./data/generated
# MINIMAX2API_MEDIA__PUBLIC_BASE_URL=
# MINIMAX2API_MEDIA__MAX_TOTAL_SIZE_MB=2048
# MINIMAX2API_MEDIA__AUTO_DOWNLOAD=true

# -------------------------------------------------------------------- signin
# MINIMAX2API_SIGNIN__ENABLED=false
# MINIMAX2API_SIGNIN__HOUR=9
# MINIMAX2API_SIGNIN__MINUTE=5
# MINIMAX2API_SIGNIN__GAP_SECONDS=2

# -------------------------------------------------------------------- signup
# Headless account registration.
# MINIMAX2API_SIGNUP__ENABLED=true
# Region to register against: global (account.minimax.io) or cn (account.minimax.cn).
# MINIMAX2API_SIGNUP__REGION=global
# Temporary-mail service (cloudflare_temp_email compatible worker).
# MINIMAX2API_SIGNUP__MAIL_BASE=https://your-mail-worker.example.com
# MINIMAX2API_SIGNUP__MAIL_DOMAIN=example.com
# Admin passkey for the mail worker.  Secret: masked in the console.
# MINIMAX2API_SIGNUP__MAIL_PASS=
# MINIMAX2API_SIGNUP__NAME_PREFIX=mmx
# MINIMAX2API_SIGNUP__MAIL_TIMEOUT_SEC=120
# MINIMAX2API_SIGNUP__MAIL_POLL_SEC=3
# Optional: set a password on each new account so a later re-login needs no inbox.
# MINIMAX2API_SIGNUP__PASSWORD=
# MINIMAX2API_SIGNUP__OAUTH_SCOPE=agent.default
# MINIMAX2API_SIGNUP__OAUTH_AUDIENCE=agent-backend
# Anti-throttle: route registrations through the proxy pool and cap per exit IP.
# MINIMAX2API_SIGNUP__USE_PROXIES=true
# MINIMAX2API_SIGNUP__PER_IP_LIMIT=3
# rotate | random | single
# MINIMAX2API_SIGNUP__PROXY_STRATEGY=rotate
# MINIMAX2API_SIGNUP__PROXY_MAX_FAIL=3
# MINIMAX2API_SIGNUP__PROXY_CHECK_URL=https://ipwho.is/
# MINIMAX2API_SIGNUP__BATCH_MAX=20
# MINIMAX2API_SIGNUP__GAP_SECONDS=3
